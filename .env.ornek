# docker compose için: bu dosyayı .env adıyla kopyala ve doldur.
USTA_MODEL=qwen3:4b-instruct-2507-q4_K_M
USTA_ENDPOINT=http://host.docker.internal:11434/v1
# Bulut servisi için anahtar (Ollama'da boş kalır)
USTA_API_KEY=
# Ev ağındaki başka cihazlardan açmak için 0.0.0.0 (trafik şifrelenmez)
USTA_BIND=127.0.0.1
USTA_PORT=8765
